{
	"schemaVersion": 1,
	"id": "lodgen",
	"version": "${version}",
	"name": "LOD Gen",
	"description": "Generates distant terrain for Voxy LODs without creating or saving real chunks.",
	"authors": [
		"OctoMiku01"
	],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.octomiku01.lodgen.LodGen"
		]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"recommends": {
		"voxy": "*"
	}
}
