{
	"schemaVersion": 1,
	"id": "lodgen",
	"version": "${version}",
	"name": "Voxy LOD Gen",
	"description": "Generates distant terrain for Voxy LODs without creating or saving real chunks.",
	"authors": [
		"OctoMiku01"
	],
	"contact": {
		"homepage": "https://github.com/OctoMiku01/Voxy-LOD-Gen",
		"sources": "https://github.com/OctoMiku01/Voxy-LOD-Gen",
		"issues": "https://github.com/OctoMiku01/Voxy-LOD-Gen/issues"
	},
	"license": "MIT",
	"icon": "assets/lodgen/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.octomiku01.lodgen.LodGen"
		],
		"client": [
			"io.github.octomiku01.lodgen.client.LodGenClient"
		],
		"modmenu": [
			"io.github.octomiku01.lodgen.client.LodModMenu"
		]
	},
	"mixins": [
		"lodgen.mixins.json",
		"lodgen.voxy.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"recommends": {
		"voxy": "*"
	},
	"suggests": {
		"modmenu": "*",
		"cloth-config": "*"
	}
}
